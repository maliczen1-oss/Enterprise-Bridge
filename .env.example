# .env.example - WealthBuilder Bridge Phase 2.1
# Copy to .env and edit values as needed.

# Server
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
API_VERSION=v1
LOG_LEVEL=INFO

# Authentication
AUTH_TOKEN=replace-with-a-strong-token

# Timeouts
REQUEST_TIMEOUT=30

# MetaTrader5 configuration
# Do NOT commit real credentials. Use a secure secret store in production.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_TIMEOUT=30000

# Operational flags
# BROKER_TRADING_ENABLED must be explicitly enabled to allow live trading.
# Default: false (safe). In production, set to true only after completing
# certification and enabling broker credentials and runtime connectivity.
BROKER_TRADING_ENABLED=false
