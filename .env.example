# WealthBuilder Bridge — environment variable template
# Copy this file to .env and populate all required values before starting.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address for the Uvicorn server.
HOST=0.0.0.0

# Bind port for the Uvicorn server.
PORT=8000

# ── Application ─────────────────────────────────────────────────────────────
# Deployment environment.  Must be one of: development | staging | production
ENVIRONMENT=development

# API version string included in health responses and OpenAPI metadata.
API_VERSION=v1

# Logging verbosity.  Must be one of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Security ────────────────────────────────────────────────────────────────
# Secret bearer token required by all protected endpoints.
# Use a cryptographically random value of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN=replace-with-a-strong-random-secret

# ── Networking ──────────────────────────────────────────────────────────────
# Maximum seconds to wait for upstream I/O responses (Phase 2.2+).
REQUEST_TIMEOUT=30
